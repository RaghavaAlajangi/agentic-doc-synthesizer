# Copy this file to .env and fill in your actual values
# ============================================================
# API CONFIGURATION
# ============================================================
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE=AGI Technical Challenge API
API_VERSION=1.0.0
LOG_LEVEL=INFO

# ============================================================
# OPENAI CONFIGURATION
# ============================================================
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-actual-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.7

# ============================================================
# CHROMA DATABASE CONFIGURATION
# ============================================================
EXTERNAL_CHROMA_HOST=chroma-external
EXTERNAL_CHROMA_PORT=8000

# ============================================================
# FRONTEND CONFIGURATION
# ============================================================
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000

# ============================================================
# DOCUMENT PROCESSING
# ============================================================
CHUNK_SIZE=512
CHUNK_OVERLAP=100
DOCUMENT_PROCESSOR_TEMPERATURE=0.5

# ============================================================
# CORS CONFIGURATION
# ============================================================
# CORS_ORIGINS is configured in settings.py by default
# To override, modify backend/config/settings.py

# ============================================================
# DEVELOPMENT
# ============================================================
DEBUG=true
PYTHONUNBUFFERED=1

# ============================================================
# LOGGING
# ============================================================
# Set to DEBUG for verbose logging, INFO for standard, WARNING for minimal
LOG_LEVEL=INFO